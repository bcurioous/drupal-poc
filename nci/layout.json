                      "tag": "p",
                      "attrs": { "class": "text-[14px] italic leading-[1.5] text-[#565c65]" },
                      "content": {
                        "type": "rich-text",
                        "parts": [
                          { "text": "If you would like to reproduce some or all of this content, see " },
                          { "links": [{ "text": "Reuse of NCI Information", "href": "#" }] },
                          { "text": " for guidance about copyright and permissions. In the case of permitted digital reproduction, please credit the National Cancer Institute as the source and link to the original NCI product using the original product's title; e.g., \"Types of Breast Cancer was originally published by the National Cancer Institute.\"" }
                        ]
                      }
                    }
